# Copy to deploy/lab.mk (gitignored) and fill in. Values here are not
# secrets: never put a password or key in this file; secrets go in
# SECRETS_DIR, one file per secret (backend/SECRETS.md).
#
# Run `make api-check` first: it prints the namespace, CPU type and
# container runtime you need below.

NODE                 = gehc@192.168.0.3

# From the node's "arch=" line: amd64 -> linux/amd64, arm64 -> linux/arm64.
PLATFORM             =

# From the node's "runtime=" line:
#   containerd under k3s:     k3s ctr images import -
#   plain containerd:         ctr -n k8s.io images import -
#   docker:                   docker load
IMPORT_CMD           =

# Palette benches rewrite pod image names to their registry, and pods never
# pull, so imported images also need that name (otherwise ErrImageNeverPull).
# Check with: kubectl -n portrait-iq get pod -o jsonpath='{..image}'
# IMAGE_ALIAS_PREFIX   = us-artifactory.apps.ge-healthcare.net/docker-axone-all

# From "Log Export service namespace:".
LOG_EXPORT_NAMESPACE =
# Only if the service is not called axone-log-export-tcp on this bench.
# LOG_EXPORT_SERVICE = axone-log-export-tcp

# Our own namespace (created and removed by make deploy / undeploy).
NAMESPACE            = portrait-iq
NODE_PORT            = 30080

# tshark live capture: a host-network pod that sees ALL traffic on the node.
# Only on a bench whose owners approved it; always pass a capture_filter for
# the traffic you need, so logins
# and other plain-HTTP traffic are not captured. RTI uses 7400 + 250 x domain:
# "udp portrange 9150-9399 or udp portrange 10400-10899" covers GE domains
# 7, 12 and 13. Default: false.
# TSHARK_LIVE_CAPTURE  = true

# Grafana / system-health collector (SCRUM-105): the in-cluster Grafana URL.
# Empty leaves the tool off. On the Axone bench the monitoring stack lives in
# the `compute` namespace; find it with:
#   kubectl get svc -A | grep grafana
# The Viewer API token is a secret, not here: put it in SECRETS_DIR as a file
# named GRAFANA_API_TOKEN (backend/SECRETS.md).
# GRAFANA_BASE_URL     = http://axone-compute-monitoring-grafana.compute.svc:80

# Full Prometheus TSDB export (SCRUM-105): the node path to the Prometheus
# data directory (the local-path PVC dir that holds prometheus-db/). Empty
# leaves the tool off. Find it on the node with:
#   PV=$(kubectl -n compute get pvc -o jsonpath='{range .items[*]}{.spec.volumeName}:{.metadata.name}{"\n"}{end}' | grep -i prometheus | head -1 | cut -d: -f1)
#   kubectl get pv "$PV" -o jsonpath='{.spec.hostPath.path}'
# WARNING: when set, this runs a short-lived ROOT pod with a read-only hostPath
# onto that dir -- the one privileged tool pod -- and writes a multi-GB archive
# into every run (needs the 40Gi data PVC, and adds heavy disk I/O near etcd).
# Have the bench owners sign off before enabling it.
# PROMETHEUS_TSDB_HOSTPATH = /opt/local-path-provisioner/pvc-..._compute_prometheus-...-db-...-0
# UMF RTI: true to turn on, false to turn off, then make deploy. Needs GE's
# rtitools image imported on the node (k3s ctr images import --local <tar>);
# RTI_IMAGE is the name it was saved under. Default: false.
# RTI                  = true
# RTI_IMAGE            = axone-umf-rtitools:temp
# The QoS file in that image. The collector reaches each UMF domain over RTI
# Real-Time WAN through the router's WAN NodePort (proven on the bench
# 2026-11-08: plain UDP never completes), so the default is the -WithWAN file,
# which has the umfwan_server_* profiles. Change only to experiment.
# RTI_QOS_FILE         = /opt/axone-tools/qos/MDH-tools-RTIAdminConsole-WithWAN.xml
# The collector builds the WAN peer (udpv4_wan://<router>:<NodePort>, where the
# router host defaults to the job's target IP, then the node). Set RTI_PEER to
# override it, or point the job's target IP at the node (e.g. 192.168.0.3).
# RTI_PEER             = udpv4_wan://192.168.0.3:32013
# A Secret (in the tools namespace) with replacement DDS security files,
# mounted over the image's set when the bench's certs were rotated and the
# image's no longer authenticate. Create it yourself; its keys must be the
# file names the image's QoS reads (Test.cert.pem, Test.key.pem,
# Test_certsigner.cert.pem, TestGovernance.p7s, TestPermissions.p7s). Empty
# keeps the image's own files. RTI_SDDS_DIR is where that QoS reads them.
# RTI_SECURITY_SECRET  = rti-dds-security
# RTI_SDDS_DIR         = /opt/axone-tools/sdds

# Absolute path to a folder outside the repo, e.g. $(HOME)/portrait-iq-secrets
SECRETS_DIR          =
