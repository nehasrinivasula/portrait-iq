# Copy to deploy/lab.mk (gitignored) and fill in. Values here are not
# secrets: never put a password or key in this file; secrets go in
# SECRETS_DIR, one file per secret (backend/SECRETS.md).
#
# Run `make api-check` first: it prints the namespace, CPU type and
# container runtime you need below.

NODE                 = gehc@192.168.0.3

# From the node's "arch=" line: amd64 -> linux/amd64, arm64 -> linux/arm64.
PLATFORM             =

# From the node's "runtime=" line:
#   containerd under k3s:     k3s ctr images import -
#   plain containerd:         ctr -n k8s.io images import -
#   docker:                   docker load
IMPORT_CMD           =

# Palette benches rewrite pod image names to their registry, and pods never
# pull, so imported images also need that name (otherwise ErrImageNeverPull).
# Check with: kubectl -n portrait-iq get pod -o jsonpath='{..image}'
# IMAGE_ALIAS_PREFIX   = us-artifactory.apps.ge-healthcare.net/docker-axone-all

# From "Log Export service namespace:".
LOG_EXPORT_NAMESPACE =
# Only if the service is not called axone-log-export-tcp on this bench.
# LOG_EXPORT_SERVICE = axone-log-export-tcp

# Our own namespace (created and removed by make deploy / undeploy).
NAMESPACE            = portrait-iq
NODE_PORT            = 30080

# tshark live capture: a host-network pod that sees ALL traffic on the node.
# Only on a bench whose owners approved it; always pass a capture_filter for
# the traffic you need, so logins
# and other plain-HTTP traffic are not captured. RTI uses 7400 + 250 x domain:
# "udp portrange 9150-9399 or udp portrange 10400-10899" covers GE domains
# 7, 12 and 13. Default: false.
# TSHARK_LIVE_CAPTURE  = true

# Absolute path to a folder outside the repo, e.g. $(HOME)/portrait-iq-secrets
SECRETS_DIR          =
