# secrets.example.env  --  FAKE VALUES, safe to commit.
#
# Shows which secrets the tool expects. Do NOT put real values in this file.
# For real use, either:
#   (a) set each NAME as an environment variable, or
#   (b) put each value in its own file OUTSIDE the repo (chmod 600) and set NAME_FILE
#       to that file's path.  Option (b) is preferred, and is how Kubernetes
#       mounts a Secret. See SECRETS.md.

# --- Box (SCRUM-43) -- auth type still to be confirmed with the Box admin ---
BOX_CLIENT_ID=fake-client-id-0000
BOX_CLIENT_SECRET=fake-client-secret-0000000000

# --- Cluster access (SCRUM-39): nothing to store here. The tool runs inside the
#     cluster and uses its own ServiceAccount (see SECRETS.md, section 4). ---

# --- Application secrets ---
# Signs session tokens for the server-side session lock (SCRUM-34).
# Generate a real one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=fake-session-key-000000000000000000000000
