# Copy to .env and adjust for your machine. .env itself is gitignored —
# never commit real values, even lab-only ones.

DATABASE_URL=sqlite:///./portrait_iq.db

DEFAULT_CPU_LIMIT_PCT=50
DEFAULT_MEM_LIMIT_MB=1024
DEFAULT_MAX_OUTPUT_MB=2048

SESSION_IDLE_TIMEOUT_SECONDS=300

# Local demo authentication. Copy this file to .env and set all three values.
# Leave credentials out of source control; use values created for your own demo.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600
